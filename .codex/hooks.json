{
  "SubagentStart": [
    {
      "matcher": ".*",
      "command": "node .codex/hooks/subagent_event_logger.mjs"
    }
  ],
  "SubagentStop": [
    {
      "matcher": ".*",
      "command": "node .codex/hooks/subagent_event_logger.mjs"
    }
  ],
  "PreToolUse": [
    {
      "matcher": "exec_command",
      "command": "node .codex/hooks/pre_tool_use_guard.mjs"
    },
    {
      "matcher": "shell_command",
      "command": "node .codex/hooks/pre_tool_use_guard.mjs"
    }
  ]
}
